---
const banners = [
    {
        href: "https://note.com/argon_society",
        label: "公式Note",
        color: "#225588",
        img: "",
    },
    { href: "https://x.com/argon_society", label: "公式X", color: "#555555" },
    {
        href: "https://wikiwiki.jp/okayama-adss/",
        label: "岡山県諸議会情報",
        color: "#228855",
    },
    { href: "#", label: "工事中", color: "#882255" },
    { href: "#", label: "工事中", color: "#885522" },
    { href: "#", label: "工事中", color: "#552288" },
];
---

<div class="banner-area">
    <div class="banner-container">
        {
            banners.map((banner) => (
                <a
                    href={banner.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="banner-link"
                >
                    <div
                        class="pixel-banner"
                        style={`background-color: ${banner.color}`}
                    >
                        <span class="banner-text">{banner.label}</span>
                    </div>
                </a>
            ))
        }
    </div>
</div>

<style>
    .banner-area {
        margin-top: 2rem;
        display: flex;
        justify-content: flex-end;
        border-top: 1px dotted #ccc;
        padding-top: 1.5rem;
    }
    .banner-container {
        display: grid;
        grid-template-columns: repeat(2, 88px);
        gap: 8px;
        justify-content: flex-end;
    }
    .banner-link {
        text-decoration: none;
        display: block;
        line-height: 0;
    }
    .pixel-banner {
        width: 88px;
        height: 31px;
        border: 1px solid #000;
        box-shadow:
            inset 1px 1px rgba(255, 255, 255, 0.4),
            inset -1px -1px rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        transition: transform 0.1s;
    }
    .pixel-banner:hover {
        transform: scale(1.05);
        filter: brightness(1.1);
    }
    .banner-text {
        font-family: "Courier New", Courier, monospace;
        font-size: 10px;
        font-weight: bold;
        color: #fff;
        text-shadow: 1px 1px #000;
        letter-spacing: 0px;
        text-align: center;
    }
    .pixel-banner:active {
        box-shadow:
            inset 1px 1px rgba(0, 0, 0, 0.6),
            inset -1px -1px rgba(255, 255, 255, 0.2);
        transform: scale(0.95);
    }
</style>
