---
// 右下に縦に並ぶ画像直張り風バナーコンポーネント
// 最小限の要素（<a> と <img> またはラベルのみ）で構成し、各種縦横比に対応します

export interface BannerItem {
    href: string;
    label: string;
    img?: string;              // バナー画像URL（指定時はimgタグを直貼り表示）
    aspect?: string;           // 縦横比（例: "88/31", "200/40", "120/60", "1/1" など）
    width?: number | string;   // 幅（指定例: 88, "88px", "120px" 等。デフォルト: 88px）
    height?: number | string;  // 高さ（指定例: 31, "31px" 等）
    bg?: string;               // 画像未指定時の背景色
    color?: string;            // 画像未指定時の文字色
}

interface Props {
    items?: BannerItem[];
}

const { items } = Astro.props;

const defaultBanners: BannerItem[] = [
    {
        href: "https://note.com/argon_society",
        label: "公式Note",
        bg: "#20466e",
        aspect: "88/31",
    },
    {
        href: "https://x.com/argon_society",
        label: "公式X",
        bg: "#2b2b2b",
        aspect: "88/31",
    },
    {
        href: "https://wikiwiki.jp/okayama-adss/",
        label: "岡山県諸議会情報",
        bg: "#1b613b",
        aspect: "88/31",
    },
    {
        href: "#",
        label: "工事中",
        bg: "#752249",
        aspect: "88/31",
    },
    {
        href: "#",
        label: "工事中",
        bg: "#694717",
        aspect: "88/31",
    },
    {
        href: "#",
        label: "工事中",
        bg: "#41246b",
        aspect: "88/31",
    },
];

const bannerList = items ?? defaultBanners;
---

<aside class="banner-rack" aria-label="バナーリンク">
    {
        bannerList.map((banner) => (
            <a
                href={banner.href}
                target={banner.href.startsWith("http") ? "_blank" : undefined}
                rel={banner.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="banner-item"
                style={{
                    "--aspect": banner.aspect || "88/31",
                    "--width": typeof banner.width === "number" ? `${banner.width}px` : (banner.width || (banner.height ? "auto" : "88px")),
                    "--height": typeof banner.height === "number" ? `${banner.height}px` : (banner.height || "auto"),
                    "--bg": banner.bg || "#333333",
                    "--color": banner.color || "#ffffff",
                }}
                title={banner.label}
            >
                {banner.img ? (
                    <img src={banner.img} alt={banner.label} loading="lazy" />
                ) : (
                    banner.label
                )}
            </a>
        ))
    }
</aside>

<style>
    /* 右下部分に縦に並ぶレイアウト */
    .banner-rack {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px dotted #cccccc;
    }

    /* 画像を直貼りしたような最小限の要素・スタイル */
    .banner-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-decoration: none;
        box-sizing: border-box;
        width: var(--width);
        height: var(--height);
        aspect-ratio: var(--aspect);
        background-color: var(--bg);
        color: var(--color);
        font-size: 11px;
        font-weight: normal;
        line-height: 1.2;
        padding: 2px 4px;
        border: 1px solid rgba(0, 0, 0, 0.2);
        overflow: hidden;
        transition: opacity 0.2s ease;
    }

    .banner-item:hover {
        opacity: 0.8;
    }

    .banner-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>
