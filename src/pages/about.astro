---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Banners from "../components/Banners.astro";
---

<BaseLayout title="協会情報｜アルゴン協会">
	<Header />
	<Navigation />
	<main>
		<article>
			<h1>協会情報</h1>
			<p>
				アルゴン協会は、人間がそれぞれ固有の価値、人格、知性及び生活上の経験を有する複数の主体であることを尊重し、多様な価値観、学問、文化及び意見が相互に併存し、批判し、協働することのできる民主的かつ多元的な社会の形成に寄与することを設立の目的とする。
			</p>
		</article>

		<section class="flex-container">
			<div class="flex-item">
				<h2><a href="/actions/">活動総合</a></h2>
				<p>創作活動 / 地域活動 / 社会活動 / 政治活動</p>
			</div>
			<div class="flex-item">
				<h2><a href="/philosophy">理念と目的</a></h2>
			</div>
		</section>
		<section class="flex-container">
			<div class="flex-item">
				<h2>定款・規則</h2>
				<p>定款</p>
			</div>
			<div class="flex-item">
				<h2>機関</h2>
				<p>
					<a href="/Organ/member">役員一覧</a> /
					<a href="/Organ/rijikai">理事会</a> /
					<a href="/argon_Institute/">アルゴン研究所</a>
				</p>
			</div>
		</section>
		<Banners />
	</main>
	<Footer />
</BaseLayout>

<style>
	a {
		color: inherit;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
