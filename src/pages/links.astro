	<Navigation />
	<main>
		<h2>リンク集</h2>
		<section class="flex-container">
			<div class="flex-item">
				<h3>地方公共団体</h3>
				<p><a href = "">岡山県</a></p>
				<p><a href = "https://www.pref.okayama.jp">岡山県</a></p>
				<p><a href = "https://www.pref.okayama.jp/page/1000.html">岡山県内市町村</a></p>
				<p><a href = "https://www.city.fukuyama.hiroshima.jp" >福山市</a></p>

				<h3>各種政治団体の県域地方組織(地方議員数順)</h3>
				<h4><a href = "">公明党</a></h4>
				<p><a href = "https://www.komei-okayama.com">公明党岡山県本部</a></p>
				<h4><a href = "">日本共産党</a></h4>
				<p><a href = "https://jcp-ok.com">日本共産党岡山県委員会</a></p>
				<h4><a href = "">自由民主党</a></h4>
