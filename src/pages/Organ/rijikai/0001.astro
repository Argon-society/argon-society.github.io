---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import Banners from "../../../components/Banners.astro";
---

<BaseLayout title="第一回理事会 | アルゴン協会">
    <Header />
    <Navigation />
    <main>
        <article>
            <h1>第一回理事会</h1>
            開催日時：2026年9月23日
            出席者：アルゴン(会長)
        </article>

        <section class="flex-container">
			<div class="flex-item">
				<h2>議事</h2>
                〇報告・承認事項
                次期統一地方選挙へ向けた各党派別擁立地図・開票結果地図の作成計画の進捗についての報告(会長)
                〇議決事項
                　1)次期統一地方選挙へ向けた活動方針要綱案
                　→全会一致で可決

                <h3>資料</h3>
			</div>
		</section>
        <Banners />
    </main>
    <Footer />
</BaseLayout>

<style>
    main {
        padding: 1rem;
        max-width: 800px;
        margin: 0 auto;
    }
    h1 {
        border-bottom: 2px solid #ccc;
        padding-bottom: 0.5rem;
    }
</style>