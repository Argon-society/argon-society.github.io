---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import Banners from "../../../components/Banners.astro";
---

<BaseLayout title="理事会 | アルゴン協会">
    <Header />
    <Navigation />
    <main>
        <article>
            <h1>理事会</h1>
        </article>

        <section>
            <div>
				<h2>理事会構成</h2>
                <table border="1" style="border-collapse:collapse;width:100%;max-width:500px;margin:20px auto;font-family:sans-serif;text-align:center;"><thead><tr style="background-color:#f0f0f0;">
                    <th>役職</th><th>理事会</th><th>役員名</th>
                </tr>
            </thead><tbody>
                <tr>
                    <td>理事長</td><td>◎</td><td>アルゴン</td>
                </tr>
            </tbody></table>
            <p>※◎：列席、〇：陪席</p>
			</div>
			<div>
				<h2>議事</h2>
                <p>理事会の議事要旨を掲載します</p>
				<ul>
                    <li><a href =/Organ/rijikai/0001/ >2026/09/23 - 第一回理事会</a></li>
                </ul>
			</div>
		</section>
        <Banners />
    </main>
    <Footer />
</BaseLayout>

<style>
	a {
		color: inherit;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
