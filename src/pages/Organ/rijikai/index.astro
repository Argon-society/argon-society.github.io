---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import Banners from "../../../components/Banners.astro";
---

<BaseLayout title="理事会 | アルゴン協会">
    <Header />
    <Navigation />
    <main>
        <article>
            <h1>理事会</h1>
            <p>アルゴン協会の執行機関であり、総会の定める範囲で一部の議決権を委譲されています</p>
        </article>

        <section>
            <div>
				<h2>理事会構成</h2>
                <table>
                    <thead>
                        <tr>
                            <th>役職名</th>
                            <th>理事会</th>
                            <th>役職者</th>
                        </tr>
                </thead>
                    <tbody>
                        <tr>
                            <td>理事長</td>
                            <td>◎</td>
                            <td>アルゴン</td>
                        </tr>
                    </tbody>
                </table>
				<ul>
                    <li><a href =/Organ/rijikai/0001/ >2026/09/23 - 第一回理事会</a></li>
                </ul>
			</div>
			<div>
				<h2>議事</h2>
                <p>理事会の議事要旨を掲載します</p>
				<ul>
                    <li><a href =/Organ/rijikai/0001/ >2026/09/23 - 第一回理事会</a></li>
                </ul>
			</div>
		</section>
        <Banners />
    </main>
    <Footer />
</BaseLayout>

<style>
	a {
		color: inherit;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
