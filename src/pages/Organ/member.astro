---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import Banners from "../../components/Banners.astro";
---

<BaseLayout title="役員一覧 | アルゴン協会">
    <Header />
    <Navigation />
    <main>
        <article>
            <h1>役員一覧</h1>
            <table>
	<tbody>
		<tr>
			<td>役職名
</td>
			<td>理事会</td>
			<td>役職者</td>
		</tr>
		<tr>
			<td>理事長</td>
			<td>〇</td>
			<td>アルゴン</td>
		</tr>
		<tr>
			<td>理事</td>
			<td>〇</td>
			<td>アルゴン</td>
		</tr>
		<tr>
			<td>アルゴン研究所所長</td>
			<td>〇</td>
			<td>アルゴン</td>
		</tr>
	</tbody>
</table>
        </article>
        <section></section>
        <Banners />
    </main>
    <Footer />
</BaseLayout>

<style>
    main {
        padding: 1rem;
        max-width: 800px;
        margin: 0 auto;
    }
    h1 {
        border-bottom: 2px solid #ccc;
        padding-bottom: 0.5rem;
    }
</style>
